# ── Copy to .env.local and fill in. Never commit .env.local. ────────────────
# On Vercel, set these in Project → Settings → Environment Variables instead.

# Sign-in (phone + OTP). Required for the auth endpoints; without AUTH_SECRET
# they answer 503 rather than fall back to anything guessable.
#   openssl rand -hex 32
AUTH_SECRET=

# SMS delivery for the one-time code — configure ONE provider.
# Until one is set, request-otp reports delivery: "unconfigured" and the
# sign-in screen says so; no code is sent and nothing pretends it was.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# — or —
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# AI styling concierge (optional). Without it the stylist falls back to a
# rule engine, so the feature still works — it just stops being Claude-powered.
# The key is only ever read server-side (api/stylist.ts).
ANTHROPIC_API_KEY=

# Instagram account whose posts are allowed on the site (optional override;
# defaults to label_by_rasika in api/instagram-post.ts).
# IG_OWNER=label_by_rasika
